@@ -0,0 +1,77 @@
+package com.huecko.backend.tiemporeal;
+
+import com.huecko.backend.postgres.repository.MiembroGrupoRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.springframework.messaging.Message;
+import org.springframework.messaging.simp.SimpMessageHeaderAccessor;
+import org.springframework.messaging.simp.SimpMessageType;
+import org.springframework.messaging.support.MessageBuilder;
+
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Quien sale de un grupo deja de recibir sus avisos en ese mismo momento, sin
+ * esperar a reconectarse.
+ */
+class FiltroSalidaStompTest {
+
+    private static final UUID GRUPO = UUID.randomUUID();
+    private static final UUID ANA = UUID.randomUUID();
+
+    private MiembroGrupoRepository miembros;
+    private SesionesStomp sesiones;
+    private FiltroSalidaStomp filtro;
+
+    @BeforeEach
+    void setUp() {
+        miembros = mock(MiembroGrupoRepository.class);
+        sesiones = new SesionesStomp();
+        filtro = new FiltroSalidaStomp(sesiones, miembros);
+        sesiones.registrar("s-ana", ANA);
+    }
+
+    @Test
+    @DisplayName("Un miembro recibe el aviso de su grupo")
+    void elMiembroLoRecibe() {
+        when(miembros.existsByGrupo_IdAndUsuario_Id(GRUPO, ANA)).thenReturn(true);
+
+        assertThat(filtro.preSend(aviso("s-ana", Destinos.grupo(GRUPO)), null)).isNotNull();
+    }
+
+    @Test
+    @DisplayName("Quien ya no es miembro no recibe el aviso aunque siga suscrito")
+    void elExMiembroNoLoRecibe() {
+        when(miembros.existsByGrupo_IdAndUsuario_Id(GRUPO, ANA)).thenReturn(false);
+
+        assertThat(filtro.preSend(aviso("s-ana", Destinos.grupo(GRUPO)), null)).isNull();
+    }
+
+    @Test
+    @DisplayName("Una sesion sin identidad registrada no recibe avisos de grupo")
+    void sesionDesconocida() {
+        assertThat(filtro.preSend(aviso("s-nadie", Destinos.grupo(GRUPO)), null)).isNull();
+    }
+
+    @Test
+    @DisplayName("Los mensajes que no son avisos de grupo pasan sin consultar nada")
+    void otrosMensajesPasan() {
+        SimpMessageHeaderAccessor ack = SimpMessageHeaderAccessor.create(SimpMessageType.CONNECT_ACK);
+        ack.setSessionId("s-ana");
+        Message<byte[]> conexion = MessageBuilder.createMessage(new byte[0], ack.getMessageHeaders());
+
+        assertThat(filtro.preSend(conexion, null)).isNotNull();
+    }
+
+    private Message<byte[]> aviso(String sesionId, String destino) {
+        SimpMessageHeaderAccessor accessor = SimpMessageHeaderAccessor.create(SimpMessageType.MESSAGE);
+        accessor.setSessionId(sesionId);
+        accessor.setDestination(destino);
+        return MessageBuilder.createMessage(new byte[0], accessor.getMessageHeaders());
+    }
+}
