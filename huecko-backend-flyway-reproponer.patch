@@ -0,0 +1,63 @@
+package com.huecko.backend.tiemporeal;
+
+import com.huecko.backend.postgres.repository.MiembroGrupoRepository;
+import lombok.RequiredArgsConstructor;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.messaging.Message;
+import org.springframework.messaging.MessageChannel;
+import org.springframework.messaging.simp.SimpMessageHeaderAccessor;
+import org.springframework.messaging.simp.SimpMessageType;
+import org.springframework.messaging.support.ChannelInterceptor;
+import org.springframework.stereotype.Component;
+
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+
+/**
+ * Última comprobación antes de que un aviso de grupo salga hacia un cliente.
+ *
+ * La pertenencia al grupo se comprobaba solo al suscribirse. Quien salía o era
+ * sacado de un grupo conservaba su suscripción y seguía recibiendo retrasos,
+ * ausencias y votaciones de ese grupo hasta que se reconectaba. Aquí se vuelve
+ * a comprobar en cada envío, así que deja de recibirlos en el momento en que
+ * deja de ser miembro.
+ *
+ * El coste es una consulta por destinatario y aviso: los grupos son de unas 20
+ * personas (RNF-07) y los avisos salen de acciones humanas, no en ráfaga.
+ */
+@Component
+@RequiredArgsConstructor
+public class FiltroSalidaStomp implements ChannelInterceptor {
+
+    private static final Logger log = LoggerFactory.getLogger(FiltroSalidaStomp.class);
+
+    private final SesionesStomp sesiones;
+    private final MiembroGrupoRepository miembroGrupoRepository;
+
+    @Override
+    public Message<?> preSend(Message<?> message, MessageChannel channel) {
+        Map<String, Object> cabeceras = message.getHeaders();
+
+        if (SimpMessageHeaderAccessor.getMessageType(cabeceras) != SimpMessageType.MESSAGE) {
+            return message;
+        }
+
+        Optional<UUID> grupoId = Destinos.grupoDe(SimpMessageHeaderAccessor.getDestination(cabeceras));
+        String sesionId = SimpMessageHeaderAccessor.getSessionId(cabeceras);
+        if (grupoId.isEmpty() || sesionId == null) {
+            return message;
+        }
+
+        // Una sesión sin identidad registrada no debería tener suscripciones;
+        // si aparece, no se le entrega nada.
+        Optional<UUID> usuarioId = sesiones.usuarioDe(sesionId);
+        if (usuarioId.isEmpty()
+                || !miembroGrupoRepository.existsByGrupo_IdAndUsuario_Id(grupoId.get(), usuarioId.get())) {
+            log.debug("Aviso del grupo {} descartado para la sesión {}: ya no es miembro", grupoId.get(), sesionId);
+            return null;
+        }
+        return message;
+    }
+}
