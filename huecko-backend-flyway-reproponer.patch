@@ -0,0 +1,100 @@
+-- ---------------------------------------------------------------------------
+-- Esquema inicial de Postgres (usuarios, grupos, planes y votos).
+--
+-- Refleja las entidades de com.huecko.backend.postgres.entity tal como las
+-- mapea Hibernate 6 para PostgreSQL, porque el perfil `prod` arranca con
+-- `ddl-auto: validate`: si una columna falta o tiene otro tipo, no arranca.
+--
+-- Cualquier cambio en una entidad necesita una migración nueva (V2__..., V3__...).
+-- Nunca editar esta: Flyway guarda su checksum y rechaza el arranque si cambia.
+--
+-- Lo de Mongo (bloques de horario, retrasos, votaciones exprés) no pasa por
+-- aquí: sus colecciones e índices los crea Spring Data al arrancar.
+-- ---------------------------------------------------------------------------
+
+create table usuarios (
+    id            uuid                        not null,
+    nombre        varchar(120)                not null,
+    email         varchar(180)                not null,
+    password_hash varchar(255)                not null,
+    creado_en     timestamp(6) with time zone not null,
+    constraint pk_usuarios primary key (id),
+    constraint uk_usuarios_email unique (email)
+);
+
+create table grupos (
+    id                    uuid                        not null,
+    nombre                varchar(120)                not null,
+    descripcion           varchar(400),
+    umbral_disponibilidad integer                     not null,
+    creado_por            uuid                        not null,
+    creado_en             timestamp(6) with time zone not null,
+    constraint pk_grupos primary key (id),
+    constraint fk_grupos_creado_por foreign key (creado_por) references usuarios (id)
+);
+
+create table miembros_grupo (
+    grupo_id          uuid        not null,
+    usuario_id        uuid        not null,
+    rol               varchar(20) not null,
+    es_imprescindible boolean     not null,
+    constraint pk_miembros_grupo primary key (grupo_id, usuario_id),
+    constraint fk_miembros_grupo_grupo foreign key (grupo_id) references grupos (id),
+    constraint fk_miembros_grupo_usuario foreign key (usuario_id) references usuarios (id),
+    constraint ck_miembros_grupo_rol check (rol in ('ORGANIZADOR', 'MIEMBRO'))
+);
+
+-- "Mis grupos" se consulta por usuario; la clave primaria empieza por grupo.
+create index idx_miembros_grupo_usuario on miembros_grupo (usuario_id);
+
+create table planes (
+    id                    uuid                        not null,
+    grupo_id              uuid                        not null,
+    titulo                varchar(120)                not null,
+    lugar                 varchar(200),
+    creado_por            uuid                        not null,
+    plazo_votacion        timestamp(6) with time zone not null,
+    estado                varchar(20)                 not null,
+    votos_multiples       boolean                     not null,
+    ventana_confirmada_id uuid,
+    creado_en             timestamp(6) with time zone not null,
+    cerrado_en            timestamp(6) with time zone,
+    constraint pk_planes primary key (id),
+    constraint fk_planes_grupo foreign key (grupo_id) references grupos (id),
+    constraint fk_planes_creado_por foreign key (creado_por) references usuarios (id),
+    constraint ck_planes_estado check (estado in ('PROPUESTO', 'CONFIRMADO', 'CANCELADO', 'EN_RECOORDINACION'))
+);
+
+create index idx_planes_grupo on planes (grupo_id);
+-- El barrido de cierre (RF-10) busca por estado y plazo cada minuto.
+create index idx_planes_estado_plazo on planes (estado, plazo_votacion);
+
+create table ventanas_plan (
+    id                        uuid    not null,
+    plan_id                   uuid    not null,
+    fecha                     date    not null,
+    hora_inicio               time(6) not null,
+    hora_fin                  time(6) not null,
+    disponibilidad_porcentaje integer not null,
+    constraint pk_ventanas_plan primary key (id),
+    constraint fk_ventanas_plan_plan foreign key (plan_id) references planes (id)
+);
+
+create index idx_ventanas_plan_plan on ventanas_plan (plan_id);
+
+-- Referencia circular (un plan apunta a su ventana ganadora y la ventana a su
+-- plan): la clave foránea se añade cuando ya existen las dos tablas.
+alter table planes
+    add constraint fk_planes_ventana_confirmada
+        foreign key (ventana_confirmada_id) references ventanas_plan (id);
+
+create table votos_ventana (
+    ventana_id uuid                        not null,
+    usuario_id uuid                        not null,
+    creado_en  timestamp(6) with time zone not null,
+    constraint pk_votos_ventana primary key (ventana_id, usuario_id),
+    constraint fk_votos_ventana_ventana foreign key (ventana_id) references ventanas_plan (id),
+    constraint fk_votos_ventana_usuario foreign key (usuario_id) references usuarios (id)
+);
+
+create index idx_votos_ventana_usuario on votos_ventana (usuario_id);
