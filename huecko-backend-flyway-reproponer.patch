--- /dev/null
+++ b/src/main/java/com/huecko/backend/tiemporeal/SesionesStomp.java
@@ -0,0 +1,34 @@
+package com.huecko.backend.tiemporeal;
+
+import org.springframework.stereotype.Component;
+
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Qué usuario hay detrás de cada sesión STOMP abierta.
+ *
+ * Los mensajes que el broker reparte a cada suscriptor solo llevan el id de la
+ * sesión, no el usuario. Este registro permite al {@link FiltroSalidaStomp}
+ * saber a quién va cada mensaje. Se rellena en el CONNECT y se vacía en el
+ * DISCONNECT (que Spring envía también cuando la conexión se corta sin avisar).
+ */
+@Component
+public class SesionesStomp {
+
+    private final Map<String, UUID> usuarioPorSesion = new ConcurrentHashMap<>();
+
+    public void registrar(String sesionId, UUID usuarioId) {
+        usuarioPorSesion.put(sesionId, usuarioId);
+    }
+
+    public void olvidar(String sesionId) {
+        usuarioPorSesion.remove(sesionId);
+    }
+
+    public Optional<UUID> usuarioDe(String sesionId) {
+        return Optional.ofNullable(usuarioPorSesion.get(sesionId));
+    }
+}
