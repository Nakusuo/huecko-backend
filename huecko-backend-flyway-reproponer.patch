+
+/**
+ * Un retraso se avisa respecto de una fecha concreta. Cuando el plan vuelve a
+ * votarse con fechas nuevas, los "llego 20 minutos tarde" de la fecha anterior
+ * ya no dicen nada, y seguían apareciendo en el resumen de puntualidad.
+ *
+ * Tras el commit, igual que los avisos: si la re-propuesta no se guarda, los
+ * retrasos siguen valiendo.
+ */
+@Component
+@RequiredArgsConstructor
+public class RetrasosAlReproponerListener {
+
+    private static final Logger log = LoggerFactory.getLogger(RetrasosAlReproponerListener.class);
+
+    private final AlertaRetrasoRepository alertaRepository;
+
+    @TransactionalEventListener(phase = TransactionPhase.AFTER_COMMIT)
+    public void alReproponer(PlanRepropuestoEvent evento) {
+        long borradas = alertaRepository.deleteByPlanId(evento.planId().toString());
+        if (borradas > 0) {
+            log.info("Plan {} con fechas nuevas: {} aviso(s) de retraso descartado(s)", evento.planId(), borradas);
+        }
+    }
+}
