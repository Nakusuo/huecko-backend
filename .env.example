# ---------------------------------------------------------------------------
# Variables de huecko-backend. Copia este archivo como `.env` y ajusta.
#
# Docker Compose lee `.env` solo. Spring Boot NO: lee el entorno del proceso.
# Mientras se dejen los valores de abajo tal cual, no hace falta nada más,
# porque application.yml trae exactamente estos mismos por defecto.
#
# Si cambias alguno, expórtalo también antes de arrancar la API. Por ejemplo:
#   export $(grep -v '^#' .env | xargs) && mvn spring-boot:run     # bash
#   Get-Content .env | ForEach-Object { if ($_ -match '^(\w+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }   # PowerShell
# ---------------------------------------------------------------------------

POSTGRES_DB=huecko
POSTGRES_USER=huecko
POSTGRES_PASSWORD=huecko
POSTGRES_PORT=5432

MONGO_DB=huecko
MONGO_USER=huecko
MONGO_PASSWORD=huecko
MONGO_PORT=27017

# Clave de firma del JWT. En desarrollo puede quedarse como está; en despliegue
# es OBLIGATORIO cambiarla. Mínimo 32 caracteres (HS256).
HUECKO_JWT_SECRET=cambia-esta-clave-de-desarrollo-huecko-2026-min-32-chars
# Vigencia del token en minutos (720 = 12 h).
HUECKO_JWT_EXPIRATION_MINUTES=720

# Orígenes permitidos por CORS, separados por coma. Solo hace falta si el
# frontend NO usa el proxy de Vite (VITE_API_URL apuntando directo al backend).
HUECKO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Correos que pasan a administrador al arrancar, separados por coma. La cuenta
# tiene que existir ya (registrarse primero y reiniciar). En desarrollo el seed
# crea admin@huecko.com / admin1234, así que puede quedarse vacío.
HUECKO_ADMIN_EMAILS=

# Zona horaria con la que se interpretan horarios, ventanas y plazos.
HUECKO_ZONA_HORARIA=America/Lima

# ---------------------------------------------------------------------------
# Servicio de IA (repo huecko-ai-service). Todo opcional: sin él la app
# funciona igual, con reglas en vez de IA.
#   docker compose --profile ia up -d
# ---------------------------------------------------------------------------

# Dónde está el servicio. Con la API en compose (--profile app) se ignora:
# allí siempre es http://ia:8000.
HUECKO_IA_URL=http://localhost:8000
# Secreto compartido: el MISMO valor lo leen la API y el contenedor de la IA.
# Sin él, la IA responde 503 a todo y la API cae a reglas.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
HUECKO_IA_TOKEN=
# Lo que la API espera a la IA antes de usar reglas (ms). Debe ser mayor que
# GEMINI_TIEMPO_MAXIMO, o la API se rendirá antes que la propia IA.
HUECKO_IA_TIEMPO_MAXIMO_MS=3000
# RF-16: `reglas` (por defecto) o `ia` (lee el motivo de la ausencia).
HUECKO_IMPREVISTOS_EVALUADOR=reglas
# Sugerencia de la IA en cada votación exprés.
HUECKO_IA_RECOMENDACIONES=false

# Solo para el contenedor de la IA.
# Clave gratuita de https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest
# Segundos que la IA espera a Gemini.
GEMINI_TIEMPO_MAXIMO=2.5

# ---------------------------------------------------------------------------
# API en contenedor (docker compose --profile app up -d)
# ---------------------------------------------------------------------------
# `dev` carga datos de demo; `prod` exige un HUECKO_JWT_SECRET propio.
SPRING_PROFILES_ACTIVE=dev
HUECKO_API_PORT=8080
